<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">AI Keyboard</string>

    <style name="Theme.AIKeyboard" parent="Theme.MaterialComponents.DayNight.NoActionBar" />

    <style name="AiChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/chip_background</item>
    </style>
</resources>
