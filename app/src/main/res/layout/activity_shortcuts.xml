<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8592;"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text Shortcuts"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollShortcuts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="0dp">

            <LinearLayout
                style="@style/SettingsCard"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Expand shortcuts as I type"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/switchShortcuts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Type a shortcut, then press space. Press backspace right after to undo. Shortcuts are never expanded in password fields."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout style="@style/SettingsCard">

                <EditText
                    android:id="@+id/editTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Shortcut (e.g. gm)"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/chip_background"
                    android:padding="12dp"
                    android:maxLength="20"
                    android:inputType="textNoSuggestions" />

                <EditText
                    android:id="@+id/editExpansion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Expands to (e.g. Good morning)"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/chip_background"
                    android:padding="12dp"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:maxLength="2000"
                    android:inputType="textMultiLine|textCapSentences" />

                <TextView
                    android:id="@+id/txtShortcutError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FF6B6B"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSaveShortcut"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="Add" />

                <TextView
                    android:id="@+id/btnCancelEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Cancel editing"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

            <EditText
                android:id="@+id/editSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:hint="Search shortcuts"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:background="@drawable/chip_background"
                android:padding="12dp"
                android:inputType="text" />

            <LinearLayout
                android:id="@+id/shortcutList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
