<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <LinearLayout
        android:id="@+id/aiPreviewPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/aiPreviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/card_background"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnPreviewCancel"
                style="@style/AiChip"
                android:text="✕ Cancel" />

            <Button
                android:id="@+id/btnPreviewAccept"
                style="@style/AiChip"
                android:text="✓ Use this" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/multiOptionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose one"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/option1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"
            android:padding="10dp" />

        <Button
            android:id="@+id/option2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"
            android:padding="10dp" />

        <Button
            android:id="@+id/option3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"
            android:padding="10dp" />

        <Button
            android:id="@+id/btnMultiCancel"
            style="@style/AiChip"
            android:text="✕ Cancel"
            android:layout_gravity="end" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/clipboardPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clipboard history"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/clipboardList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/emojiPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:visibility="gone">

        <EditText
            android:id="@+id/emojiSearchBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search emoji…"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:background="@drawable/chip_background"
            android:padding="10dp"
            android:layout_margin="6dp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <GridLayout
                android:id="@+id/emojiGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="8"
                android:padding="6dp" />

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/wordSuggestBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_surface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button android:id="@+id/wordSuggest1" style="@style/AiChip" android:text="" android:visibility="gone" />
        <Button android:id="@+id/wordSuggest2" style="@style/AiChip" android:text="" android:visibility="gone" />
        <Button android:id="@+id/wordSuggest3" style="@style/AiChip" android:text="" android:visibility="gone" />
        <Button android:id="@+id/emojiSuggest" style="@style/AiChip" android:text="" android:visibility="gone" />

        <Button
            android:id="@+id/btnEmoji"
            style="@style/AiChip"
            android:text="😊" />

        <Button
            android:id="@+id/btnClipboard"
            style="@style/AiChip"
            android:text="📋" />

        <Button
            android:id="@+id/btnMic"
            style="@style/AiChip"
            android:text="🎤" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:scrollbars="none"
        android:background="@color/bg_surface">

        <LinearLayout
            android:id="@+id/suggestionStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btnFixGrammar"
                style="@style/AiChip"
                android:text="✓ Fix" />

            <Button
                android:id="@+id/btnToneProfessional"
                style="@style/AiChip"
                android:text="Professional" />

            <Button
                android:id="@+id/btnToneFriendly"
                style="@style/AiChip"
                android:text="Friendly" />

            <Button
                android:id="@+id/btnToneCasual"
                style="@style/AiChip"
                android:text="Casual" />

            <Button
                android:id="@+id/btnToneFormal"
                style="@style/AiChip"
                android:text="Formal" />

            <Button
                android:id="@+id/btnToneFunny"
                style="@style/AiChip"
                android:text="Funny" />

            <Button
                android:id="@+id/btnToneFlirty"
                style="@style/AiChip"
                android:text="Flirty" />

            <Button
                android:id="@+id/btnSuggestReply"
                style="@style/AiChip"
                android:text="💬 Reply" />

            <Button
                android:id="@+id/btnExplain"
                style="@style/AiChip"
                android:text="❓ Explain" />

            <Button
                android:id="@+id/btnCvMode"
                style="@style/AiChip"
                android:text="📄 CV" />

            <Button android:id="@+id/btnBusinessMode" style="@style/AiChip" android:text="💼 Business" />
            <Button android:id="@+id/btnTonePolite" style="@style/AiChip" android:text="Polite" />
            <Button android:id="@+id/btnToneConfident" style="@style/AiChip" android:text="Confident" />
            <Button android:id="@+id/btnShorten" style="@style/AiChip" android:text="✂️ Shorten" />
            <Button android:id="@+id/btnExpand" style="@style/AiChip" android:text="↔️ Expand" />
            <Button android:id="@+id/btnTranslate" style="@style/AiChip" android:text="🌐 Translate" />
            <Button android:id="@+id/btnDecline" style="@style/AiChip" android:text="🚫 Decline" />

        </LinearLayout>
    </HorizontalScrollView>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@drawable/key_background"
        android:keyTextColor="@color/text_primary"
        android:keyTextSize="18sp"
        android:background="@color/bg_deep" />

</LinearLayout>
