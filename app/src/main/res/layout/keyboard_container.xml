<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#14142B">

    <LinearLayout
        android:id="@+id/aiPreviewPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1C1C3A"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/aiPreviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#14142B"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnPreviewCancel"
                style="@style/AiChip"
                android:text="✕ Cancel" />

            <Button
                android:id="@+id/btnPreviewAccept"
                style="@style/AiChip"
                android:text="✓ Use this" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wordSuggestBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1C1C3A"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <Button android:id="@+id/wordSuggest1" style="@style/AiChip" android:text="" android:visibility="gone" />
        <Button android:id="@+id/wordSuggest2" style="@style/AiChip" android:text="" android:visibility="gone" />
        <Button android:id="@+id/wordSuggest3" style="@style/AiChip" android:text="" android:visibility="gone" />

        <Button
            android:id="@+id/btnMic"
            style="@style/AiChip"
            android:layout_gravity="end"
            android:text="🎤" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:background="#1C1C3A">

        <LinearLayout
            android:id="@+id/suggestionStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <Button
                android:id="@+id/btnFixGrammar"
                style="@style/AiChip"
                android:text="✓ Fix" />

            <Button
                android:id="@+id/btnToneProfessional"
                style="@style/AiChip"
                android:text="Professional" />

            <Button
                android:id="@+id/btnToneFriendly"
                style="@style/AiChip"
                android:text="Friendly" />

            <Button
                android:id="@+id/btnToneCasual"
                style="@style/AiChip"
                android:text="Casual" />

            <Button
                android:id="@+id/btnToneFormal"
                style="@style/AiChip"
                android:text="Formal" />

            <Button
                android:id="@+id/btnToneFunny"
                style="@style/AiChip"
                android:text="Funny" />

            <Button
                android:id="@+id/btnToneFlirty"
                style="@style/AiChip"
                android:text="Flirty" />

            <Button
                android:id="@+id/btnSuggestReply"
                style="@style/AiChip"
                android:text="💬 Reply" />

        </LinearLayout>
    </HorizontalScrollView>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@drawable/key_background"
        android:keyTextColor="#FFFFFF"
        android:keyTextSize="18sp"
        android:background="#14142B" />

</LinearLayout>
