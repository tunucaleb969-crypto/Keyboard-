# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already covered by .gitignore below.

# Server-side Gemini key. This never gets shipped in the Android app.
GEMINI_API_KEY=

# Shared secret the Android app sends as the X-App-Key header.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SHARED_SECRET=

# Optional overrides:
# GEMINI_MODEL=gemini-3.1-flash-lite
# RATE_LIMIT_PER_MINUTE=30

# Optional provider switch. Keep all provider keys on the server only.
# AI_PROVIDER=gemini
# For a trusted OpenAI-compatible endpoint, set all three values and use:
# AI_PROVIDER=openai-compatible
# COMPATIBLE_API_KEY=
# COMPATIBLE_BASE_URL=https://your-provider.example/v1
# COMPATIBLE_MODEL=provider-model-id
